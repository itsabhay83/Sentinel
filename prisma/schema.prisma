generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User{
  id        String       @id        @default(uuid())
  email     String
}
model Websites{
  id        String  @id         @default(uuid())
  url       String  
  userId    String
}
model Validator{
  id        String      @id       @default(uuid())
  publicKey String  
  location  String
  ip        String

  
}
model WebsiteTick{
  id        String      @id       @default(uuid())
  websiteId String  
  ValidatorId String  
  createdAt  DateTime
  status      websiteStatus
  latency     Float
}
enum websiteStatus{
  Good , 
  Bad
}
